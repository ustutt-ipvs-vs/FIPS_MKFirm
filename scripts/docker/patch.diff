+package d6g.devices.skipfactor;
+import inet.queueing.filter.BackPressureBasedFilter;
+
+// This module implements a packet filter that drops packets when the following module (consumer)
+// does not allow packets to be pushed. The module itself accepts all packets (i.e. canPushPacket()
+// and canPushSomePacket() always return true). This is useful, for example, when the following
+// module is a gate to filter out packets when the gate is closed.
+simple SkipFactorBackPressureBasedFilter extends BackPressureBasedFilter
+{
+    parameters:
+        @class(SkipFactorBackPressureBasedFilter);
+}
diff --git a/src/devices/skipfactor/SkipFactorIeee8021qFilter.ned b/src/devices/skipfactor/SkipFactorIeee8021qFilter.ned
new file mode 100644
index 0000000..bcc3912
--- /dev/null
+++ b/src/devices/skipfactor/SkipFactorIeee8021qFilter.ned
@@ -0,0 +1,67 @@
+package d6g.devices.skipfactor;
+
+import inet.queueing.common.BackPressureBarrier;
+import inet.queueing.common.PacketMultiplexer;
+import inet.queueing.contract.IPacketClassifier;
+import inet.queueing.contract.IPacketFilter;
+import inet.queueing.contract.IPacketGate;
+import inet.queueing.contract.IPacketMeter;
+
+module SkipFactorIeee8021qFilter like IPacketFilter
+{
+    parameters:
+        int numStreams = default(0); // number of default streams to filter for
+        int numSkipFactorStreams = default(0); // number of streams to filter for
+        int startY = default(200);
+        int startSkipFactorY = default(200 + 150 * numStreams);
+        @display("i=block/filter");
+    gates:
+        input in;
+        output out;
+    submodules:
+        classifier: <default("SkipFactorStreamClassifier")> like IPacketClassifier {
+            gateIndexOffset = 1;
+            defaultGateIndex = 0;
+            @display("p=100,100");
+        }
+        gateFilter[numStreams]: <default("SkipFactorBackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startY,column,150");
+        }
+        gateSkipFactorFilter[numSkipFactorStreams]: <default("SkipFactorBackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startSkipFactorY,column,150");
+        }
+        gate[numStreams + numSkipFactorStreams]: <default("InteractiveGate")> like IPacketGate {
+            @display("p=500,$startY,column,150");
+        }
+        meter[numStreams + numSkipFactorStreams]: <default("DualRateThreeColorMeter")> like IPacketMeter {
+            @display("p=700,$startY,column,150");
+        }
+        filter[numStreams + numSkipFactorStreams]: <default("LabelFilter")> like IPacketFilter {
+            labelFilter = default("green");
+            @display("p=900,$startY,column,150");
+        }
+        multiplexer: PacketMultiplexer {
+            @display("p=1100,100");
+        }
+        barrier: BackPressureBarrier {
+            @display("p=1300,100");
+        }
+    connections:
+        in --> { @display("m=w"); } --> classifier.in;
+        classifier.out++ --> multiplexer.in++;
+        for i=0..numStreams-1 {
+            classifier.out++ --> gateFilter[i].in;
+            gateFilter[i].out --> gate[i].in;
+	}
+        for i=0..numSkipFactorStreams-1 {
+            classifier.out++ --> gateSkipFactorFilter[i].in;
+            gateSkipFactorFilter[i].out --> gate[numStreams+i].in;
+	}
+        for i=0..numStreams+numSkipFactorStreams-1 {
+            gate[i].out --> meter[i].in;
+            meter[i].out --> filter[i].in;
+            filter[i].out --> multiplexer.in++;
+        }
+        multiplexer.out --> barrier.in;
+        barrier.out --> { @display("m=e"); } --> out;
+}
diff --git a/src/devices/skipfactor/SkipFactorStreamClassifier.cc b/src/devices/skipfactor/SkipFactorStreamClassifier.cc
new file mode 100644
index 0000000..9a5c179
--- /dev/null
+++ b/src/devices/skipfactor/SkipFactorStreamClassifier.cc
@@ -0,0 +1,108 @@
+#include "SkipFactorStreamClassifier.h"
+#include "inet/linklayer/common/PcpTag_m.h"
+#include "inet/protocolelement/redundancy/StreamTag_m.h"
+#include "inet/queueing/contract/IPacketFilter.h"
+
+namespace d6g {
+
+Define_Module(SkipFactorStreamClassifier);
+
+void SkipFactorStreamClassifier::initialize(int stage) {
+  StreamClassifier::initialize(stage);
+  if (stage == INITSTAGE_LOCAL) {
+    skipFactor = check_and_cast<cValueMap *>(par("skipFactor").objectValue());
+    period = check_and_cast<cValueMap *>(par("period").objectValue());
+    elevatedPcp = par("elevatedPcp");
+
+    for (auto &entry : skipFactor->getFields()) {
+      lastSent[entry.first] = simTime();
+      lastLossDetected[entry.first] = simTime();
+    }
+  }
+}
+
+int SkipFactorStreamClassifier::classifyPacket(Packet *packet) {
+  // get streamName, as in StreamClassifier::classifyPacket
+  const char *frameName = nullptr;
+  switch (*mode) {
+  case 'r': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      frameName = streamReq->getStreamName();
+    break;
+  }
+  case 'i': {
+    auto streamInd = packet->findTag<StreamInd>();
+    if (streamInd != nullptr)
+      frameName = streamInd->getStreamName();
+    break;
+  }
+  case 'b': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      frameName = streamReq->getStreamName();
+    else {
+      auto streamInd = packet->findTag<StreamInd>();
+      if (streamInd != nullptr)
+        frameName = streamInd->getStreamName();
+    }
+    break;
+  }
+  }
+
+  std::string frameNameStr(frameName);
+  std::string streamNameStr = frameNameStr.substr(0, frameNameStr.find("-"));
+  const char *streamName = streamNameStr.c_str();
+
+  // keep default functionality for non-emergency-traffic-enabled frames
+  int outputGateIndex = defaultGateIndex;
+  if (frameName != nullptr && mapping->containsKey(frameName)) {
+    outputGateIndex = mapping->get(frameName).intValue() + gateIndexOffset;
+  }
+
+  if (streamName != nullptr && !skipFactor->containsKey(streamName)) {
+    EV << "No SkipFactor configured; passes normal PSFP " << streamName << endl;
+    return outputGateIndex;
+  }
+
+  assert(packet->findTag<PcpInd>() != nullptr);
+  auto period = SimTime(this->period->get(streamName).doubleValueInUnit("ms"),
+                        SimTimeUnit::SIMTIME_MS);
+  auto cycle_start = simTime() - fmod(simTime(), period);
+
+  // check if previously sent frame was sent over the timespan of
+  // one period ago (indicating that a frame has been lost)
+  auto last = cycle_start - period;
+  EV << "LastSent " << lastSent.at(streamName) << " " << last << endl;
+  if (lastSent.at(streamName) < last) {
+    EV << "LastLossDetected is updated" << endl;
+    lastLossDetected[streamName] = cycle_start;
+  }
+
+  // frame can be forwarded via normal PSFP gate
+  if (consumers[outputGateIndex].canPushPacket(packet)) {
+    lastSent[streamName] = cycle_start;
+    EV << "Passes normal PSFP (passed)" << endl;
+    return outputGateIndex;
+  }
+
+  // check whether to drop of elevate frame
+  int skipFactor = this->skipFactor->get(streamName).intValue();
+  auto lastAllowedLoss = cycle_start - skipFactor * period;
+  EV << "LastLoss " << lastLossDetected.at(streamName) << " " << lastAllowedLoss
+     << endl;
+  if (lastLossDetected.at(streamName) <= lastAllowedLoss) {
+    // drop frame
+    EV << "Passes normal PSFP (dropped)" << endl;
+    return outputGateIndex;
+  }
+
+  // elevate frame
+  EV << "Elevate priority" << endl;
+  lastSent[streamName] = cycle_start;
+  auto pcpInd = packet->getTagForUpdate<PcpInd>();
+  pcpInd->setPcp(elevatedPcp);
+  return defaultGateIndex;
+}
+
+} // namespace d6g
