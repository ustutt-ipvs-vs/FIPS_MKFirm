+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+#ifndef DETERMINISTIC6G_UDPEDGECLOUDBASICAPP_H_
+#define DETERMINISTIC6G_UDPEDGECLOUDBASICAPP_H_
+
+#include "inet/applications/udpapp/UdpBasicApp.h"
+#include <omnetpp.h>
+
+using namespace omnetpp;
+using namespace inet;
+namespace d6g {
+
+/**
+ * UdpEdgeCloudBasicApp is based on the UdpEchoApp. It is used to forward
+ * packets to another node (or back) and delay them. See the NED file for more
+ * info.
+ */
+class INET_API UdpEdgeCloudBasicApp : public UdpBasicApp {
+protected:
+  virtual void initialize(int stage) override;
+  virtual void processStart() override;
+  virtual void processSend() override;
+
+  cPar *delayParameter = nullptr;
+  clocktime_t sendInterval = 0;
+  clocktime_t time_until_next_period = 0;
+};
+
+} // namespace d6g
+
+#endif
