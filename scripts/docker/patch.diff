@@ -0,0 +1,12 @@
+package d6g.devices.emergencyelevation;
+import inet.protocolelement.redundancy.StreamClassifier;
+
+simple EmergencyStreamClassifier extends StreamClassifier
+{
+    parameters:
+        object emergencyMapping = default({}); // maps stream name to gate index
+        object emergencyAllowedFrameLoss = default({}); // allowed frame loss per gate
+        object defaultPcpMapping = default({}); // default PCP values of emergency streams
+	int emergencyPcp = default(7); // PCP value of emergency traffic
+        @class(EmergencyStreamClassifier);
+}
