+#define DETERMINISTIC6G_STREAMCLASSIFIER_H
+
+#include "inet/protocolelement/redundancy/StreamClassifier.h"
+
+namespace d6g {
+using namespace inet;
+
+class INET_API EmergencyStreamClassifier : public StreamClassifier {
+protected:
+  cValueMap *emergencyMapping = nullptr;
+  cValueMap *emergencyAllowedFrameLoss = nullptr;
+  cValueMap *defaultPcpMapping = nullptr;
+  int emergencyPcp = 0;
+
+  std::map<std::basic_string<char>, int> frameLossCounter;
+
+protected:
+  virtual void initialize(int stage) override;
+  virtual int classifyPacket(Packet *packet) override;
+};
+
+} // namespace d6g
+
+#endif
