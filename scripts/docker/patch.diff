+//
+
+#include "OctetLimitedPeriodicGate.h"
+
+namespace d6g {
+
+Define_Module(OctetLimitedPeriodicGate);
+
+void OctetLimitedPeriodicGate::initialize(int stage) {
+  PeriodicGate::initialize(stage);
+  if (stage == INITSTAGE_LOCAL) {
+    octetLimit = par("octetLimit");
+  }
+}
+
+void OctetLimitedPeriodicGate::handleParameterChange(const char *name) {
+  if (!strcmp(name, "octetLimit"))
+    octetLimit = par("octetLimit");
+  PeriodicGate::handleParameterChange(name);
+}
+
+void OctetLimitedPeriodicGate::open() {
+  PeriodicGate::open();
+  octetsLeft_ = octetLimit;
+}
+
+bool OctetLimitedPeriodicGate::canPacketFlowThrough(Packet *packet) const {
+  bool allowed = PeriodicGate::canPacketFlowThrough(packet);
+
+  EV << "OctetLimit: " << packet->getTotalLength().get() << " " << octetsLeft_
+     << endl;
+  if (packet->getTotalLength().get() <= octetsLeft_) {
+    return true;
+  }
+  return false;
+}
+
+void OctetLimitedPeriodicGate::processPacket(Packet *packet) {
+  PeriodicGate::processPacket(packet);
+  octetsLeft_ -= packet->getTotalLength().get();
+}
+
+} // namespace d6g
