+package d6g.devices.mkfirm_elevation_policy;
+
+import inet.queueing.common.BackPressureBarrier;
+import inet.queueing.common.PacketMultiplexer;
+import inet.queueing.contract.IPacketClassifier;
+import inet.queueing.contract.IPacketFilter;
+import inet.queueing.contract.IPacketGate;
+import inet.queueing.contract.IPacketMeter;
+
+module MKFirmIeee8021qFilter like IPacketFilter
+{
+    parameters:
+        int numStreams = default(0); // number of default streams to filter for
+        int numMKFirmStreams = default(0); // number of (m,k)-firm streams to filter for
+        int startY = default(200);
+        int startMKFirmY = default(200 + 150 * numStreams);
+        @display("i=block/filter");
+    gates:
+        input in;
+        output out;
+    submodules:
+        classifier: <default("MKFirmStreamClassifier")> like IPacketClassifier {
+            gateIndexOffset = 1;
+            defaultGateIndex = 0;
+            @display("p=100,100");
+        }
+        gateFilter[numStreams]: <default("MKFirmBackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startY,column,150");
+        }
+        gateMKFirmFilter[numMKFirmStreams]: <default("MKFirmBackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startMKFirmY,column,150");
+        }
+        gate[numStreams + numMKFirmStreams]: <default("InteractiveGate")> like IPacketGate {
+            @display("p=500,$startY,column,150");
+        }
+        meter[numStreams + numMKFirmStreams]: <default("DualRateThreeColorMeter")> like IPacketMeter {
+            @display("p=700,$startY,column,150");
+        }
+        filter[numStreams + numMKFirmStreams]: <default("LabelFilter")> like IPacketFilter {
+            labelFilter = default("green");
+            @display("p=900,$startY,column,150");
+        }
+        multiplexer: PacketMultiplexer {
+            @display("p=1100,100");
+        }
+        barrier: BackPressureBarrier {
+            @display("p=1300,100");
+        }
+    connections:
+        in --> { @display("m=w"); } --> classifier.in;
+        classifier.out++ --> multiplexer.in++;
+        for i=0..numStreams-1 {
+            classifier.out++ --> gateFilter[i].in;
+            gateFilter[i].out --> gate[i].in;
+	}
+        for i=0..numMKFirmStreams-1 {
+            classifier.out++ --> gateMKFirmFilter[i].in;
+            gateMKFirmFilter[i].out --> gate[numStreams+i].in;
+	}
+        for i=0..numStreams+numMKFirmStreams-1 {
+            gate[i].out --> meter[i].in;
+            meter[i].out --> filter[i].in;
+            filter[i].out --> multiplexer.in++;
+        }
+        multiplexer.out --> barrier.in;
+        barrier.out --> { @display("m=e"); } --> out;
+}
diff --git a/src/devices/mkfirm_elevation_policy/MKFirmStreamClassifier.cc b/src/devices/mkfirm_elevation_policy/MKFirmStreamClassifier.cc
new file mode 100644
index 0000000..3958ad1
--- /dev/null
+++ b/src/devices/mkfirm_elevation_policy/MKFirmStreamClassifier.cc
@@ -0,0 +1,87 @@
+#include "MKFirmStreamClassifier.h"
+#include "inet/linklayer/common/PcpTag_m.h"
+#include "inet/protocolelement/redundancy/StreamTag_m.h"
+#include "inet/queueing/contract/IPacketFilter.h"
+
+namespace d6g {
+
+Define_Module(MKFirmStreamClassifier);
+
+void MKFirmStreamClassifier::initialize(int stage) {
+  StreamClassifier::initialize(stage);
+  if (stage == INITSTAGE_LOCAL) {
+    mkFirmMapping =
+        check_and_cast<cValueMap *>(par("mkFirmMapping").objectValue());
+    elevatedPcp = par("elevatedPcp");
+  }
+}
+
+int MKFirmStreamClassifier::classifyPacket(Packet *packet) {
+  // get streamName, as in StreamClassifier::classifyPacket
+  const char *streamName = nullptr;
+  switch (*mode) {
+  case 'r': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      streamName = streamReq->getStreamName();
+    break;
+  }
+  case 'i': {
+    auto streamInd = packet->findTag<StreamInd>();
+    if (streamInd != nullptr)
+      streamName = streamInd->getStreamName();
+    break;
+  }
+  case 'b': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      streamName = streamReq->getStreamName();
+    else {
+      auto streamInd = packet->findTag<StreamInd>();
+      if (streamInd != nullptr)
+        streamName = streamInd->getStreamName();
+    }
+    break;
+  }
+  }
+
+  int outputGateIndex = defaultGateIndex;
+  if (streamName != nullptr && mapping->containsKey(streamName)) {
+    outputGateIndex = mapping->get(streamName).intValue() + gateIndexOffset;
+  }
+
+  if (streamName != nullptr && mkFirmMapping->containsKey(streamName)) {
+    int mkFirmOutputGateIndex =
+        mkFirmMapping->get(streamName).intValue() + gateIndexOffset;
+    EV << "Gates: " << outputGateIndex << " " << mkFirmOutputGateIndex << endl;
+
+    if (packet->findTag<PcpInd>() != nullptr) {
+      auto pcpInd = packet->getTagForUpdate<PcpInd>();
+      // Frame is already elevated
+      if (pcpInd->getPcp() == elevatedPcp) {
+        EV << "Expedited forwarding of elevated frame" << endl;
+        return defaultGateIndex;
+      }
+      // Frame passes normal PSFP (and can be handled by GCL)
+      if (consumers[outputGateIndex].canPushPacket(packet)) {
+        EV << "Passes normal PSFP" << endl;
+        return outputGateIndex;
+      }
+      // At this point, decide whether to elevate or discard
+      if (consumers[mkFirmOutputGateIndex].canPushPacket(packet)) {
+        // Elevate priority
+        EV << "Elevate priority" << endl;
+        auto pcpInd = packet->getTagForUpdate<PcpInd>();
+        pcpInd->setPcp(elevatedPcp);
+        return mkFirmOutputGateIndex;
+      }
+    }
+  }
+
+  // There are two cases when reaching this line
+  // Normal frames -> outputGateIndex is normal way of PSFP handling
+  // MKfirm frames -> outputGateIndex is closed and frame is discarded
+  return outputGateIndex;
+}
+
+} // namespace d6g
