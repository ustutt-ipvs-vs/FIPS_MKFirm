@@ -0,0 +1,60 @@
+// This file is part of Deliverable D4.1 DetCom Simulator Framework Release 1
+// of the DETERMINISTIC6G project receiving funding from the
+// European Union’s Horizon Europe research and innovation programme
+// under Grant Agreement No. 101096504.
+//
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+#include "ExprTTDelayer.h"
+#include "inet/common/packet/PacketFilter.h"
+
+namespace d6g {
+    Define_Module (ExprTTDelayer);
+
+    void ExprTTDelayer::initialize(int stage)
+    {
+        InterfaceFilterMixin::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            mapping = check_and_cast<cValueArray *>(par("delays").objectValue());
+        }
+    }
+
+    clocktime_t ExprTTDelayer::computeDelay(Packet* packet) const
+    {
+        clocktime_t delay;
+        if (!matchesInterfaceConfiguration(packet)) {
+	    EV_INFO << "no interface match" << endl;
+            delay = 0;
+        }
+        else {
+            auto nonConstThis = const_cast<ExprTTDelayer *>(this);
+            for (int i = 0; i < mapping->size(); i++) {
+		EV_INFO << "test " << i << endl;
+                auto element = check_and_cast<cValueMap *>(mapping->get(i).objectValue());
+                PacketFilter packetFilter;
+                auto packetPattern = element->containsKey("packetFilter") ? element->get("packetFilter") : cValue("*");
+                packetFilter.setExpression(packetPattern);
+                if (packetFilter.matches(packet)) {
+		    EV_INFO << "match" << endl;
+                    auto delayExpression = new cDynamicExpression();
+                    delayExpression->parseNedExpr(element->get("delay").stringValue());
+                    delay = delayExpression->doubleValue(nonConstThis, "s");
+                }
+            }
+        }
+
+        return delay;
+    }
+
+    void ExprTTDelayer::setDelay(cPar* delays)
+    {
+        mapping = check_and_cast<cValueArray *>(delays->objectValue());
+    }
+
+    void ExprTTDelayer::handleParameterChange(const char* parname)
+    {
+        if (!strcmp(parname, "delays")) {
+            setDelay(&par("delays"));
+        }
+    }
+} // namespace d6g
