+package d6g.devices.emergencyelevation;
+
+import inet.queueing.common.BackPressureBarrier;
+import inet.queueing.common.PacketMultiplexer;
+import inet.queueing.contract.IPacketClassifier;
+import inet.queueing.contract.IPacketFilter;
+import inet.queueing.contract.IPacketGate;
+import inet.queueing.contract.IPacketMeter;
+
+module EmergencyIeee8021qFilter like IPacketFilter
+{
+    parameters:
+        int numStreams = default(0); // number of default streams to filter for
+        int numEmergencyStreams = default(0); // number of emergency streams to filter for
+        int startY = default(200);
+        int startEmergencyY = default(200 + 150 * numStreams);
+        @display("i=block/filter");
+    gates:
+        input in;
+        output out;
+    submodules:
+        classifier: <default("EmergencyStreamClassifier")> like IPacketClassifier {
+            gateIndexOffset = 1;
+            defaultGateIndex = 0;
+            @display("p=100,100");
+        }
+        gateFilter[numStreams]: <default("BackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startY,column,150");
+        }
+        gateEmergencyFilter[numEmergencyStreams]: <default("EmergencyBackPressureBasedFilter")> like IPacketFilter {
+            @display("p=300,$startEmergencyY,column,150");
+        }
+        gate[numStreams + numEmergencyStreams]: <default("InteractiveGate")> like IPacketGate {
+            @display("p=500,$startY,column,150");
+        }
+        meter[numStreams + numEmergencyStreams]: <default("DualRateThreeColorMeter")> like IPacketMeter {
+            @display("p=700,$startY,column,150");
+        }
+        filter[numStreams + numEmergencyStreams]: <default("LabelFilter")> like IPacketFilter {
+            labelFilter = default("green");
+            @display("p=900,$startY,column,150");
+        }
+        multiplexer: PacketMultiplexer {
+            @display("p=1100,100");
+        }
+        barrier: BackPressureBarrier {
+            @display("p=1300,100");
+        }
+    connections:
+        in --> { @display("m=w"); } --> classifier.in;
+        classifier.out++ --> multiplexer.in++;
+        for i=0..numStreams-1 {
+            classifier.out++ --> gateFilter[i].in;
+            gateFilter[i].out --> gate[i].in;
+	}
+        for i=0..numEmergencyStreams-1 {
+            classifier.out++ --> gateEmergencyFilter[i].in;
+            gateEmergencyFilter[i].out --> gate[numStreams+i].in;
+	}
+        for i=0..numStreams+numEmergencyStreams-1 {
+            gate[i].out --> meter[i].in;
+            meter[i].out --> filter[i].in;
+            filter[i].out --> multiplexer.in++;
+        }
+        multiplexer.out --> barrier.in;
+        barrier.out --> { @display("m=e"); } --> out;
+}
diff --git a/src/devices/emergencyelevation/EmergencyStreamClassifier.cc b/src/devices/emergencyelevation/EmergencyStreamClassifier.cc
new file mode 100644
index 0000000..8971703
--- /dev/null
+++ b/src/devices/emergencyelevation/EmergencyStreamClassifier.cc
@@ -0,0 +1,106 @@
+#include "EmergencyStreamClassifier.h"
+#include "inet/linklayer/common/PcpTag_m.h"
+#include "inet/protocolelement/redundancy/StreamTag_m.h"
+#include "inet/queueing/contract/IPacketFilter.h"
+
+namespace d6g {
+
+Define_Module(EmergencyStreamClassifier);
+
+void EmergencyStreamClassifier::initialize(int stage) {
+  StreamClassifier::initialize(stage);
+  if (stage == INITSTAGE_LOCAL) {
+    emergencyMapping =
+        check_and_cast<cValueMap *>(par("emergencyMapping").objectValue());
+    emergencyAllowedFrameLoss = check_and_cast<cValueMap *>(
+        par("emergencyAllowedFrameLoss").objectValue());
+    defaultPcpMapping =
+        check_and_cast<cValueMap *>(par("defaultPcpMapping").objectValue());
+    emergencyPcp = par("emergencyPcp");
+
+    for (auto &entry : emergencyAllowedFrameLoss->getFields())
+      frameLossCounter[entry.first] = 0;
+  }
+}
+
+int EmergencyStreamClassifier::classifyPacket(Packet *packet) {
+  // keep default functionality for non-emergency-traffic-enabled frames
+  int outputGateIndex = StreamClassifier::classifyPacket(packet);
+  if (outputGateIndex != defaultGateIndex) {
+    return outputGateIndex;
+  }
+
+  // get streamName, as in StreamClassifier::classifyPacket
+  const char *streamName = nullptr;
+  switch (*mode) {
+  case 'r': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      streamName = streamReq->getStreamName();
+    break;
+  }
+  case 'i': {
+    auto streamInd = packet->findTag<StreamInd>();
+    if (streamInd != nullptr)
+      streamName = streamInd->getStreamName();
+    break;
+  }
+  case 'b': {
+    auto streamReq = packet->findTag<StreamReq>();
+    if (streamReq != nullptr)
+      streamName = streamReq->getStreamName();
+    else {
+      auto streamInd = packet->findTag<StreamInd>();
+      if (streamInd != nullptr)
+        streamName = streamInd->getStreamName();
+    }
+    break;
+  }
+  }
+
+  if (streamName != nullptr && emergencyMapping->containsKey(streamName)) {
+    int outputGateIndex =
+        emergencyMapping->get(streamName).intValue() + gateIndexOffset;
+    std::string emergencyGateIndex =
+        std::to_string(outputGateIndex - gateIndexOffset);
+    int &frameLoss = frameLossCounter[emergencyGateIndex];
+    int frameLossLimit =
+        emergencyAllowedFrameLoss->get(emergencyGateIndex.c_str()).intValue();
+
+    if (packet->findTag<PcpInd>() != nullptr) {
+      auto pcpInd = packet->getTagForUpdate<PcpInd>();
+      if (consumers[outputGateIndex].canPushPacket(packet)) {
+        if (pcpInd->getPcp() == emergencyPcp &&
+            defaultPcpMapping->containsKey(emergencyGateIndex.c_str())) {
+          EV << "Emergency frame did catch and can be downgraded" << endl;
+          int defaultPcp =
+              defaultPcpMapping->get(emergencyGateIndex.c_str()).intValue();
+          pcpInd->setPcp(defaultPcp);
+        }
+      } else if (pcpInd->getPcp() == emergencyPcp) {
+        EV << "Expedited forwarding of emergency frame" << endl;
+        frameLoss = 0;
+        return defaultGateIndex;
+      } else if (frameLoss == frameLossLimit) {
+        EV << "Elevating packet to emergency traffic" << endl;
+        auto pcpInd = packet->getTagForUpdate<PcpInd>();
+        pcpInd->setPcp(emergencyPcp);
+      }
+    }
+
+    if (consumers[outputGateIndex].canPushPacket(packet)) {
+      frameLoss = 0;
+      return outputGateIndex;
+    } else if (frameLoss < frameLossLimit) {
+      frameLoss++;
+      return outputGateIndex;
+    } else {
+      frameLoss = 0;
+      return defaultGateIndex;
+    }
+  }
+
+  return defaultGateIndex;
+}
+
+} // namespace d6g
