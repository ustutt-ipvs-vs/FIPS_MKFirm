@@ -0,0 +1,86 @@
+// This file is part of Deliverable D4.1 DetCom Simulator Framework Release 1
+// of the DETERMINISTIC6G project receiving funding from the
+// European Union’s Horizon Europe research and innovation programme
+// under Grant Agreement No. 101096504.
+//
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+#include "UdpEdgeCloudBasicApp.h"
+#include "inet/common/Simsignals.h"
+#include "inet/networklayer/common/L3AddressResolver.h"
+
+namespace d6g {
+using namespace inet;
+
+Define_Module(UdpEdgeCloudBasicApp);
+
+void UdpEdgeCloudBasicApp::initialize(int stage) {
+    UdpBasicApp::initialize(stage);
+
+    if (stage == INITSTAGE_LOCAL) {
+        this->delayParameter = &par("delay");
+    }
+}
+
+void UdpEdgeCloudBasicApp::processStart() {
+    socket.setOutputGate(gate("socketOut"));
+    const char *localAddress = par("localAddress");
+    socket.bind(*localAddress ? L3AddressResolver().resolve(localAddress)
+                              : L3Address(),
+                localPort);
+    setSocketOptions();
+
+    const char *destAddrs = par("destAddresses");
+    cStringTokenizer tokenizer(destAddrs);
+    const char *token;
+
+    while ((token = tokenizer.nextToken()) != nullptr) {
+        destAddressStr.push_back(token);
+        L3Address result;
+        L3AddressResolver().tryResolve(token, result);
+        if (result.isUnspecified())
+            EV_ERROR << "cannot resolve destination address: " << token << endl;
+        destAddresses.push_back(result);
+    }
+
+    if (!destAddresses.empty()) {
+        selfMsg->setKind(SEND);
+        // Begin Modification
+        sendInterval = static_cast<clocktime_t>(par("sendInterval"));
+        clocktime_t processing_delay = this->delayParameter->doubleValue();
+        if (processing_delay >= sendInterval) {
+            throw cRuntimeError("Processing delay must be smaller than send interval");
+        }
+        time_until_next_period = sendInterval - processing_delay;
+        scheduleClockEventAfter(processing_delay, selfMsg);
+        // End Modification
+    } else {
+        if (stopTime >= CLOCKTIME_ZERO) {
+            selfMsg->setKind(STOP);
+            scheduleClockEventAt(stopTime, selfMsg);
+        }
+    }
+}
+
+void UdpEdgeCloudBasicApp::processSend() {
+    sendPacket();
+    // Begin Modification
+    clocktime_t processing_delay = this->delayParameter->doubleValue();
+
+    if (processing_delay >= sendInterval) {
+        throw cRuntimeError("Processing delay must be smaller than send interval");
+    }
+
+    clocktime_t d = time_until_next_period + processing_delay;
+    time_until_next_period =
+            static_cast<clocktime_t>(par("sendInterval")) - processing_delay;
+    // End Modification
+    if (stopTime < CLOCKTIME_ZERO || getClockTime() + d < stopTime) {
+        selfMsg->setKind(SEND);
+        scheduleClockEventAfter(d, selfMsg);
+    } else {
+        selfMsg->setKind(STOP);
+        scheduleClockEventAt(stopTime, selfMsg);
+    }
+}
+} // namespace d6g
